{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/engine/shared/**/*",
    "src/engine/model/**/*"
  ],
  "exclude": [
    "src/engine/shared/**/__tests__/**/*",
    "src/engine/model/**/__tests__/**/*",
    "dist"
  ]
}
